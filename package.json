{
  "name": "@darco2903/rcon-ts",
  "version": "1.1.0",
  "author": "Darco2903",
  "description": "Minimal TypeScript client for the Source RCON protocol (Source engine games, Minecraft, ...), built on neverthrow",
  "keywords": [
    "rcon",
    "source-rcon",
    "srcds",
    "minecraft",
    "valve",
    "typescript",
    "neverthrow"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Darco2903/rcon-ts#readme",
  "bugs": {
    "url": "https://github.com/Darco2903/rcon-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darco2903/rcon-ts.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tests",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf -g dist darco2903-rcon-ts-*.tgz"
  },
  "dependencies": {
    "@darco2903/typed-emitter": "^1.3.1"
  },
  "peerDependencies": {
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "neverthrow": "^8.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
